APP_NAME=BuildWise AI Agent
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
SECRET_KEY=change-me-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=120
DATABASE_URL=sqlite:///./storage/buildwise.db
UPLOAD_DIR=storage/uploads
ANNOTATED_DIR=storage/annotated
REPORTS_DIR=storage/reports
MAX_UPLOAD_MB=10
VISION_PROVIDER=safety_hybrid
VISION_MODEL_PATH=
YOLO_MODEL_PATH=storage/models/yolov8n-10cls.pt
YOLO_CONF_THRESHOLD=0.5
VISION_LLM_PROVIDER=zhipu
VISION_LLM_CLAUDE_CMD=claude
VISION_LLM_TIMEOUT=180
# 视觉 LLM 用智谱 GLM-4V（OpenAI 兼容），独立于文本 LLM 的 DeepSeek（纯文本不支持视觉）
VISION_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VISION_LLM_API_KEY=bdd24f66c9a447af86bd07987fa8068a.8DpGmgBSqxf51zQo
VISION_LLM_MODEL=glm-4v-flash
RETRIEVAL_PROVIDER=local_keyword
CHROMA_MIN_SCORE=0.42
TEXT_PROVIDER=openai_compatible
KNOWLEDGE_JSON_PATH=../data_demo/standards/safety_standards.json
CHROMA_DIR=storage/chroma
# DeepSeek 文本 LLM：日报文案 + 知识库智能问答（/knowledge/chat 自动升级 rag_llm）。
# deepseek-chat 为纯文本模型，不支持视觉/语音转写，因此视觉 LLM 独立配置为智谱 GLM-4V（见 VISION_LLM_*）、SPEECH_PROVIDER=off。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-f1631eaa85ca40b5a6a07d0a32eeb8b8
LLM_MODEL=deepseek-chat
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 实时天气（工友关怀预填）：qweather 和风天气。2026 年起使用账号专属 API Host（控制台「开发者信息」查看）。
WEATHER_PROVIDER=qweather
WEATHER_API_BASE_URL=https://p64gkm8xwn.re.qweatherapi.com/v7
WEATHER_API_KEY=f93ab99a5a6d4a40abcbb6c3311c1128
WEATHER_CITY=beijing

# 定时关怀：每天 08:00 按 beijing 预报日最高气温自动评估高温等级、写入关怀历史，橙/红色高温联动语音广播
CARE_SCHEDULE_ENABLED=true
CARE_SCHEDULE_TIME=08:00
# CARE_SCHEDULE_CITY=beijing
