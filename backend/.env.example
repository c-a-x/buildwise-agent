APP_NAME=BuildWise AI Agent
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
SECRET_KEY=change-me-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=120
DATABASE_URL=sqlite:///./storage/buildwise.db
UPLOAD_DIR=storage/uploads
ANNOTATED_DIR=storage/annotated
REPORTS_DIR=storage/reports
MAX_UPLOAD_MB=10
VISION_PROVIDER=mock
VISION_MODEL_PATH=
# safety_hybrid 使用的 YOLO 模型与置信度阈值（10 类微调权重可直接替换默认 COCO 模型）
YOLO_MODEL_PATH=storage/models/yolov8n.pt
YOLO_CONF_THRESHOLD=0.5
# quality_hybrid 使用的质量缺陷 YOLO 模型（MBDD2025 训练产物，5 类：裂缝/渗漏/剥落/锈蚀/鼓包）
QUALITY_MODEL_PATH=storage/models/yolov8n-5cls-mbdd.pt
QUALITY_CONF_THRESHOLD=0.45
# safety_hybrid 的 LLM 隐患分析引擎：claude_cli | doubao | off
# 无 LLM key 时留 off，自动降级为纯 YOLO（is_simulated=False，仍为真实检测）
VISION_LLM_PROVIDER=off
VISION_LLM_CLAUDE_CMD=claude
VISION_LLM_TIMEOUT=180
RETRIEVAL_PROVIDER=local_keyword
CHROMA_MIN_SCORE=0.42
TEXT_PROVIDER=template
KNOWLEDGE_JSON_PATH=../data_demo/standards/safety_standards.json
QUALITY_KNOWLEDGE_JSON_PATH=../data_demo/standards/quality_standards.json
# 绿色碳排核算因子库：GB/T 51366-2019 因子法；verified=true 直接采用，verified=false 为演示推算值
GREEN_FACTORS_PATH=../data_demo/green/factors.json
# 绿色真实公开数据参考库：中国建筑 2024 年度 ESG/年报披露数值（来源可核验）
GREEN_REFERENCE_PATH=../data_demo/green/reference.json
# 工友关怀规则库：高温分级（《防暑降温措施管理办法》）、温馨提示/急救/福利设施
WELLBEING_RULES_PATH=../data_demo/wellbeing/rules.json
# 实时天气（工友关怀预填，可选）：off=手动输入；openweather=OpenWeather 兼容 API（需外网+key）
# WEATHER_PROVIDER=openweather
# WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5
# WEATHER_API_KEY=你的key
# WEATHER_CITY=beijing
CHROMA_DIR=storage/chroma
# 豆包（火山方舟）视觉模型：VISION_LLM_PROVIDER=doubao 时必填
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_API_KEY=你的key
# LLM_MODEL=doubao-seed-2-0-mini-260215
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 语音转写：off=前端浏览器 Web Speech 本地识别；openai_compatible=后端 whisper 兼容接口（复用上方 LLM_* 配置）
SPEECH_PROVIDER=off
# 实时监控硬报警 webhook（ESP32 蜂鸣器预留）。检测到高危隐患时后台 POST 到该地址，默认空禁用
# ALERT_WEBHOOK_URL=http://192.168.1.50/api/alert
# 语音广播 webhook（网络音响/PA，预留）。检测到高危隐患时后台 POST 文字 + 可选 mp3 音频，默认空禁用
# BROADCAST_WEBHOOK_URL=http://192.168.1.60/api/tts
# TTS_PROVIDER=off      # off=只推文字（设备自己念）；edge_tts=后端合成 mp3（需外网，pip install edge-tts）；mock=占位音频演示
# TTS_VOICE=zh-CN-XiaoxiaoNeural
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
